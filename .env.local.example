# LLM (Anthropic) — required for real narrative generation; mock fallback when missing
ANTHROPIC_API_KEY=sk-ant-...
SKILLNEX_MOCK_LLM=false

# Auth secret — required for production; better-auth uses this to sign session tokens.
# Generate with: openssl rand -hex 32. MUST differ between US and EU droplets.
SKILLNEX_AUTH_SECRET=dev-only-secret-change-me-32-bytes-min

# Public base URL — used in OAuth redirects + email links
SKILLNEX_BASE_URL=http://localhost:3000

# Region pin — must match the physical datacenter this droplet runs in.
# Signups for the OTHER region are 409'd with a redirect to the right
# host (see docs/deploy.md). Leave UNSET for local dev to allow both.
# Values: us | eu
# SKILLNEX_REGION=us

# Email (Resend) — optional; missing key falls back to console-log mock
RESEND_API_KEY=re_...
# IMPORTANT: must use a domain you've verified in Resend. The default
# onboarding@resend.dev sandbox sender ONLY delivers to the email address
# that owns your Resend account — every other recipient is silently dropped.
RESEND_FROM_EMAIL="Skillnex <noreply@yourdomain.com>"
